#CSS Code
/* =========================
   GENERAL STYLING
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    color: #222;
    line-height: 1.6;
}

a {
    text-decoration: none;
}


/* =========================
   NAVIGATION BAR
========================= */

header {
    background-color: #ffffff;
    padding: 20px 8%;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 28px;
    font-weight: bold;
    color: #2563eb;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 30px;
}

.nav-links a {
    color: #333333;
    font-weight: bold;
}

.nav-links a:hover {
    color: #2563eb;
}

.nav-button {
    background-color: #2563eb;
    color: white;
    padding: 12px 22px;
    border-radius: 6px;
}


/* =========================
   HERO SECTION
========================= */

.hero {
    min-height: 550px;
    background-color: #eff6ff;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 60px 8%;
    gap: 40px;
}

.hero-content {
    flex: 1;
}

.hero-content h1 {
    font-size: 48px;
    line-height: 1.2;
    margin-bottom: 20px;
}

.hero-content p {
    font-size: 18px;
    color: #555555;
    margin-bottom: 30px;
}

.primary-button {
    display: inline-block;
    background-color: #2563eb;
    color: white;
    padding: 14px 25px;
    border-radius: 6px;
}

.primary-button:hover,
.nav-button:hover {
    background-color: #1d4ed8;
}

.hero-image {
    flex: 1;
    min-width: 0;
}

.hero-image img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 15px;
}


/* =========================
   ABOUT SECTION
========================= */

.about {
    text-align: center;
    padding: 70px 10%;
}

.about h2 {
    font-size: 32px;
    margin-bottom: 20px;
}

.about p {
    font-size: 17px;
    color: #555555;
    max-width: 750px;
    margin: auto;
}


/* =========================
   SERVICES SECTION
========================= */

.services {
    background-color: #f8fafc;
    text-align: center;
    padding: 70px 8%;
}

.services h2 {
    font-size: 32px;
    margin-bottom: 30px;
}

.service-container {
    display: flex;
    justify-content: center;
    gap: 25px;
}

.service-card {
    flex: 1;
    background-color: white;
    padding: 35px 25px;
    border-radius: 10px;

    box-shadow: 0 3px 15px rgba(0, 0, 0, 0.08);
}

.service-card h3 {
    color: #2563eb;
    margin-bottom: 15px;
}

.service-card p {
    color: #555555;
}


/* =========================
   CONTACT SECTION
========================= */

.contact {
    text-align: center;
    padding: 70px 20px;
    background-color: #eff6ff;
}

.contact h2 {
    font-size: 32px;
    margin-bottom: 15px;
}

.contact p {
    margin-bottom: 25px;
}


/* =========================
   FOOTER
========================= */

footer {
    background-color: #172554;
    color: white;
    text-align: center;
    padding: 22px;
}


/* =========================
   MOBILE RESPONSIVE DESIGN
   SCREEN WIDTH: 375px
========================= */

@media screen and (max-width: 600px) {

    /* Navigation */

    header {
        padding: 20px;
    }

    .navbar {
        flex-direction: column;
        gap: 20px;
    }

    .nav-links {
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    /* Hero Section */

    .hero {
        flex-direction: column;
        text-align: center;
        padding: 45px 20px;
        gap: 30px;
    }

    .hero-content h1 {
        font-size: 32px;
    }

    .hero-content p {
        font-size: 16px;
    }

    .hero-image {
        width: 100%;
    }

    /* About Section */

    .about {
        padding: 50px 20px;
    }

    .about h2 {
        font-size: 28px;
    }

    /* Services Section */

    .services {
        padding: 50px 20px;
    }

    .services h2 {
        font-size: 28px;
    }

    .service-container {
        flex-direction: column;
    }

    .service-card {
        width: 100%;
    }

    /* Contact Section */

    .contact {
        padding: 50px 20px;
    }

    .contact h2 {
        font-size: 26px;
    }

}
